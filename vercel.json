{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/Docs/index.html" },
    { "source": "/readme", "destination": "/Docs/readme.html" },
    { "source": "/01", "destination": "/Docs/01_master_plan.html" },
    { "source": "/02", "destination": "/Docs/02_browser_agent.html" },
    { "source": "/03", "destination": "/Docs/03_perception_problem.html" },
    { "source": "/04", "destination": "/Docs/04_hld.html" },
    { "source": "/05", "destination": "/Docs/05_browser_extension.html" },
    { "source": "/06", "destination": "/Docs/06_team_presentation.html" },
    { "source": "/07", "destination": "/Docs/07_reality_check_and_innovations.html" },
    { "source": "/08", "destination": "/Docs/08_ml_privacy_module.html" },
    { "source": "/demo", "destination": "/demo/test-demo.html" },
    { "source": "/Docs/(.*)", "destination": "/Docs/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
